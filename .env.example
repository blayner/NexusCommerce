# Application
NODE_ENV=development
PORT=3000

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN_SECONDS=3600

# PostgreSQL
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus_commerce?schema=public

# Redis (cache, carts and BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_DEFAULT_TTL_SECONDS=300

# Cart
CART_TTL_SECONDS=604800

# Payments
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
PIX_KEY=pagamentos@nexuscommerce.dev
PIX_MERCHANT_NAME=NEXUS COMMERCE
PIX_MERCHANT_CITY=SAO PAULO
