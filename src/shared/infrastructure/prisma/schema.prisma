// NexusCommerce persistence model.
//
// Each bounded context owns its tables; cross-module references (e.g. Order.customerId,
// OrderItem.productId) are plain identifiers rather than foreign keys so modules can be
// extracted into separate services without untangling the schema.

// Prisma 7: Rust-free client generated as TypeScript into src/generated (git-ignored,
// produced by `prisma generate` on postinstall). The connection URL lives in
// prisma.config.ts for the CLI and is handed to the `pg` driver adapter at runtime.
// importFileExtension is pinned: without it the generator infers the extension from a tsconfig.json,
// and the Docker deps stage runs `prisma generate` before tsconfig.json is copied, which produced
// `./internal/class.ts` imports that crash the compiled app at startup.
generator client {
  provider            = "prisma-client"
  output              = "../../../generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- identity

model User {
  id           String   @id
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("CUSTOMER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

// ---------------------------------------------------------------- catalog

model Category {
  id        String     @id
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("categories")
}

model Product {
  id                    String    @id
  sku                   String    @unique
  name                  String
  description           String    @default("")
  priceInCents          Int
  compareAtPriceInCents Int?
  currency              String    @default("BRL") @db.VarChar(3)
  categoryId            String?
  category              Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stockOnHand           Int       @default(0)
  stockReserved         Int       @default(0)
  active                Boolean   @default(true)
  version               Int       @default(1)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([categoryId])
  @@index([priceInCents])
  @@index([active, createdAt])
  @@map("products")
}

// ---------------------------------------------------------------- ordering

model Order {
  id                 String      @id
  customerId         String
  customerEmail      String
  status             String
  currency           String      @db.VarChar(3)
  subtotalInCents    Int
  discountInCents    Int
  shippingInCents    Int
  totalInCents       Int
  couponCode         String?
  paymentId          String?
  trackingCode       String?
  cancellationReason String?
  inventoryState     String      @default("NONE")
  idempotencyKey     String?     @unique
  history            Json        @default("[]")
  items              OrderItem[]
  version            Int         @default(1)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([customerId, createdAt(sort: Desc)])
  @@index([paymentId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id               String @id
  orderId          String
  order            Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  sku              String
  name             String
  unitPriceInCents Int
  quantity         Int

  @@index([orderId])
  @@map("order_items")
}

// ---------------------------------------------------------------- payments

model Payment {
  id                String    @id
  orderId           String
  customerId        String
  amountInCents     Int
  currency          String    @db.VarChar(3)
  method            String
  methodDetails     Json
  status            String
  idempotencyKey    String    @unique
  providerReference String?   @unique
  declineReason     String?
  instructions      Json?
  expiresAt         DateTime?
  refundedAt        DateTime?
  version           Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([orderId])
  @@index([status, expiresAt])
  @@map("payments")
}

// ---------------------------------------------------------------- notifications

model Notification {
  id                String    @id
  channel           String
  recipient         String
  template          String
  payload           Json
  status            String
  attempts          Int       @default(0)
  lastError         String?
  providerMessageId String?
  dedupKey          String?   @unique
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, createdAt])
  @@map("notifications")
}
